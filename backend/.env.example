# Servidor
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS)
CLIENT_URL=http://localhost:5173

# Base de datos
# En PRODUCCIÓN no uses root: crea un usuario con permisos mínimos, p. ej.:
#   CREATE USER 'fidelizacion_app'@'localhost' IDENTIFIED BY 'una_contrasena_segura';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON db_fidelizacion.* TO 'fidelizacion_app'@'localhost';
#   FLUSH PRIVILEGES;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_fidelizacion
DB_USER=fidelizacion_app
DB_PASSWORD=una_contrasena_segura

# Autenticacion
# Genera secretos fuertes con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secreto_aleatorio_largo
JWT_EXPIRES_IN=15m
REFRESH_SECRET=genera_otro_secreto_aleatorio_distinto
REFRESH_EXPIRES_IN=7d
